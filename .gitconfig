[user]
	name = Alex Louden
	email = alex@louden.com
	signingkey = BC1865638D45B0E970058FABE5E90055152127FE

[core]
	excludesfile = /Users/alex/.gitignore_global
	editor = code --wait
	ignorecase = false

[diff]
  tool = vscode
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE

[merge]
  tool = vscode
[mergetool "vscode"]
  cmd = code --wait $MERGED


[credential]
	helper = osxkeychain
[push]
	default = current
	autoSetupRemote = true

[url "ssh://git@heroku.com/"]
	insteadOf = https://git.heroku.com/

[url "ssh://git@github.com/"]
	insteadOf = https://github.com/

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[commit]
	template = /Users/alex/.stCommitMsg
	gpgsign = true
[pull]
	rebase = false
[remote]
	pushDefault = github
[gpg]
	program = /opt/homebrew/bin/gpg
	format = openpgp
[fetch]
	prune = true
[submodule]
	recurse = true
[init]
	defaultBranch = main
[safe]
	directory = *
