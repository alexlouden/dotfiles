# PostgreSQL
# export DYLD_FALLBACK_LIBRARY_PATH=$HOME/lib:/usr/local/lib:/usr/lib:/Applications/Postgres.app/Contents/MacOS/lib

# PIP
export PIP_VIRTUALENV_BASE=$WORKON_HOME
export PIP_RESPECT_VIRTUALENV=true

# Timing
PROMPT_TITLE='echo -ne "\033]0;${USER}@${HOSTNAME%%.*}:${PWD/#$HOME/~}\007"'
export PROMPT_COMMAND="${PROMPT_COMMAND} ${PROMPT_TITLE}; "

# Default editor
export EDITOR='code'

# Old PS1
# export PS1="\[\e[0;32m\]\u \w \n\$\[\e[0m\] "

# compilation
# export ARCHFLAGS="-arch x86_64"

# vmrun binary
# export PATH="$PATH:/Applications/VMware Fusion.app/Contents/Library"

# Poetry
# export PATH="$PATH:/Users/alex/.poetry/bin/"

# GO
# export GOPATH=$HOME/go/

# PostgreSQL
export PATH="$PATH:/Applications/Postgres.app/Contents/Versions/latest/bin"

# Heroku Toolbelt
export PATH="/usr/local/heroku/bin:$PATH"

# Terraform and packer
export PATH="/Users/alex/terraform:$PATH"
# export PATH="/Users/alex/packer:$PATH"

# YARN
export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"

# Python user packages (pipenv)
export PATH="$PATH:$HOME/.local/bin"

# OpenCV
# export PATH="/usr/local/opt/opencv3/bin:$PATH"

# Fastlane
# export PATH="$HOME/.fastlane/bin:$PATH"

# Code
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# Dotnet
# export PATH="$PATH:/usr/local/share/dotnet"

# Java
# export PATH="/usr/local/opt/openjdk/bin:$PATH"

# Google cloud
# source "$(brew --prefix)/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc"

# GDAL 3.9
# export PATH="/opt/homebrew/Cellar/gdal/3.9/bin:$PATH"
# export GDAL_LIBRARY_PATH="/opt/homebrew/Cellar/gdal/3.9/lib/libgdal.dylib"
# export LD_LIBRARY_PATH="/opt/homebrew/Cellar/gdal/3.9/lib:$LD_LIBRARY_PATH"
# export GEOS_LIBRARY_PATH="/opt/homebrew/opt/geos/lib/libgeos_c.dylib"

# # add both to dynamic library path too
# export DYLD_LIBRARY_PATH="/opt/homebrew/Cellar/gdal/3.9/lib:$DYLD_LIBRARY_PATH"
# export DYLD_LIBRARY_PATH="/opt/homebrew/opt/geos/lib:$DYLD_LIBRARY_PATH"

# GDAL 3.11.3
export PATH="/opt/homebrew/Cellar/gdal/3.11.3/bin:$PATH"
export GDAL_LIBRARY_PATH="/opt/homebrew/Cellar/gdal/3.11.3/lib/libgdal.dylib"
export LD_LIBRARY_PATH="/opt/homebrew/Cellar/gdal/3.11.3/lib:$LD_LIBRARY_PATH"
export GEOS_LIBRARY_PATH="/opt/homebrew/Cellar/geos/3.13.1/lib/libgeos_c.dylib"

# add both to dynamic library path too
export DYLD_LIBRARY_PATH="/opt/homebrew/Cellar/gdal/3.11.3/lib:$DYLD_LIBRARY_PATH"
export DYLD_LIBRARY_PATH="/opt/homebrew/Cellar/geos/3.13.1/lib:$DYLD_LIBRARY_PATH"